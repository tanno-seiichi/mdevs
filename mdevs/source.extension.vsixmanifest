<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="mdevs.91f72ca7-7cd1-472b-98ba-20909b2c603c" Version="0.1.3.0" Language="en-US" Publisher="tanno-seiichi" />
    <DisplayName>mdevs - Inline Markdown Editor for Visual Studio</DisplayName>
    <Description>WYSIWYG Markdown editor: edit Markdown files directly in the preview. Markdown ファイルを、プレビューのまま直接編集できるエディター。</Description>
    <!-- インストールの画面に表示するライセンス（mdevs のライセンスと、WebView2 のライセンス） -->
    <License>LICENSE.txt</License>
    <Icon>images\mde.png</Icon>
    <!-- Marketplace・「拡張機能の管理」の検索に使う言葉 -->
    <Tags>Markdown;WYSIWYG;Editor;md</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[18.0, )" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
